---
// Editorial cover for an engineering note: an abstract drafting plate drawn at
// build time (inline SVG, no JS, no images). Reusable for every note: the
// motif comes from the note's optional `cover.motif` frontmatter, otherwise
// from a hash of the slug; the layout varies deterministically with the slug,
// so each note gets its own plate and rebuilds never change it.
//
// Motifs (pick the one closest to the note's argument):
// - split:    two lanes across a boundary (fixed rules | changing data)
// - pipeline: modules in sequence, one gate on the way
// - layers:   stacked slabs joined through their centers
// - graph:    nodes on a grid joined by orthogonal edges
//
// Visual grammar: hairline measurement ticks, modules on the raised surface,
// connectors in the strong border color, one filled key node. Theme-aware
// through tokens; decorative (aria-hidden), so it never needs alt text.
export type CoverMotif = "split" | "pipeline" | "layers" | "graph";

interface Props {
  slug: string;
  motif?: CoverMotif;
  /** plate: 4:3 (notes index label column). band: 4:1 (note header). */
  variant?: "plate" | "band";
}

const { slug, motif: chosen, variant = "plate" } = Astro.props;
const [W, H] = variant === "plate" ? [160, 120] : [480, 120];

let seed = 2166136261;
for (const ch of slug) seed = Math.imul(seed ^ ch.charCodeAt(0), 16777619) >>> 0;
const rand = () => {
  seed = (seed + 0x6d2b79f5) >>> 0;
  let t = seed;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const motifs: CoverMotif[] = ["split", "pipeline", "layers", "graph"];
const motif = chosen ?? motifs[seed % motifs.length];
const pick = (min: number, max: number, step = 2) => min + Math.round((rand() * (max - min)) / step) * step;

type Rect = { x: number; y: number; w: number; h: number; hollow?: boolean };
const modules: Rect[] = [];
const lines: string[] = [];
const keys: [number, number][] = [];
const P = 14;

if (motif === "split") {
  const edge = Math.round(W * (variant === "plate" ? 0.46 : 0.4));
  lines.push(`M${edge} 8V${H - 8}`);
  const w = Math.min(44, edge - 2 * P);
  const ys = [26, 54, 82];
  for (const y of ys) modules.push({ x: P, y, w, h: 14 });
  for (let i = 1; i < ys.length; i++) lines.push(`M${P + w / 2} ${ys[i - 1] + 14}V${ys[i]}`);
  const rows = variant === "plate" ? [24, 52, 80] : [22, 50, 78];
  const target = Math.floor(rand() * rows.length);
  let tx = edge + 14;
  rows.forEach((y, i) => {
    // The data lane: modules of varying width placed anywhere across the lane.
    const lane = W - P - (edge + 14);
    const mw = pick(variant === "plate" ? 26 : 60, variant === "plate" ? lane - 8 : Math.round(lane * 0.55));
    const x = edge + 14 + (variant === "plate" ? 0 : pick(0, lane - mw));
    modules.push({ x, y, w: Math.min(mw, W - P - x), h: pick(10, 16), hollow: i !== target });
    if (i === target) tx = x;
  });
  const sy = ys[2] + 7;
  const ty = rows[target] + 6;
  lines.push(`M${P + w} ${sy}H${edge}V${ty}H${tx}`);
  keys.push([edge, sy]);
} else if (motif === "pipeline") {
  const count = variant === "plate" ? 3 : 5;
  const y = H / 2 - 8;
  const span = W - 2 * P;
  const slot = span / count;
  let prev = 0;
  for (let i = 0; i < count; i++) {
    const w = Math.min(slot - 12, pick(18, 40));
    const x = P + i * slot + (slot - 12 - w) / 2;
    modules.push({ x, y: y + pick(-6, 6), w, h: 16, hollow: i === count - 1 });
    if (i > 0) lines.push(`M${prev} ${H / 2}H${x}`);
    prev = x + w;
  }
  const gate = modules[Math.floor(count / 2)];
  const gx = gate.x - 6;
  lines.push(`M${gx} ${H / 2 - 9}V${H / 2 + 9}`, `M${gx - 3} ${H / 2 - 9}V${H / 2 + 9}`);
  keys.push([modules[0].x + modules[0].w, H / 2]);
} else if (motif === "layers") {
  const count = 4;
  let w = W - 2 * P - pick(0, 20);
  for (let i = 0; i < count; i++) {
    const y = 14 + i * 26;
    modules.push({ x: (W - w) / 2, y, w, h: 12, hollow: i === 1 });
    if (i > 0) lines.push(`M${W / 2} ${y - 14}V${y}`);
    w = Math.max(30, w - pick(16, 40));
  }
  keys.push([W / 2, 14 + 26 + 12 + 7]);
} else {
  const cols = variant === "plate" ? 4 : 8;
  const rows = 3;
  const gx = (W - 2 * P) / (cols - 1);
  const gy = (H - 2 * P - 8) / (rows - 1);
  const pts: [number, number][] = [];
  for (let c = 0; c < cols; c++) {
    const r = Math.floor(rand() * rows);
    pts.push([P + c * gx, P + 4 + r * gy]);
  }
  for (let i = 1; i < pts.length; i++) lines.push(`M${pts[i - 1][0]} ${pts[i - 1][1]}H${(pts[i - 1][0] + pts[i][0]) / 2}V${pts[i][1]}H${pts[i][0]}`);
  pts.forEach(([x, y], i) => modules.push({ x: x - 5, y: y - 5, w: 10, h: 10, hollow: i % 3 === 1 }));
  keys.push(pts[Math.floor(rand() * pts.length)]);
}

// Measurement ticks along the top and left edges: the plate's drafting frame.
const ticks: string[] = [];
for (let x = 0; x <= W; x += 10) ticks.push(`M${x} 0V${x % 50 === 0 ? 5 : 3}`);
for (let y = 10; y <= H; y += 10) ticks.push(`M0 ${y}H${y % 50 === 0 ? 5 : 3}`);
---

<svg class:list={["cover", `cover-${variant}`]} viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false" data-motif={motif}>
  <path class="cover-ticks" d={ticks.join("")}></path>
  <path class="cover-lines" d={lines.join("")}></path>
  {modules.map((m) => <rect class:list={["cover-module", m.hollow && "cover-module-hollow"]} x={m.x} y={m.y} width={m.w} height={m.h} rx="1.5" />)}
  {keys.map(([x, y]) => <circle class="cover-key" cx={x} cy={y} r="2.75" />)}
</svg>

<style>
  .cover {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .cover :is(path, rect, circle) {
    vector-effect: non-scaling-stroke;
  }

  .cover-ticks {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1;
  }

  .cover-lines {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  .cover-module {
    fill: var(--color-surface-raised);
    stroke: var(--color-border-strong);
    stroke-width: 1;
  }

  .cover-module-hollow {
    fill: none;
  }

  .cover-key {
    fill: var(--color-text);
  }
</style>

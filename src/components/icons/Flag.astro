---
// Small flags for the language menu: USA for English, Mexico for Español.
// Secondary to the text label (aria-hidden; the language name is the cue).
// Simplified for 16px: the US flag keeps stripes and canton (stars are
// illegible at this size); the Mexican flag keeps its bands and a small
// emblem mark. Official colors, framed by a hairline so they sit on the
// page's neutral palette.
interface Props {
  code: "en" | "es";
}

const { code } = Astro.props;
const stripe = 16 / 13;
---

<svg class="flag" viewBox="0 0 24 16" width="16" height="11" aria-hidden="true" focusable="false">
  {
    code === "en" ? (
      <>
        <rect width="24" height="16" fill="#fff" />
        {Array.from({ length: 7 }, (_, i) => (
          <rect y={i * 2 * stripe} width="24" height={stripe} fill="#B22234" />
        ))}
        <rect width="10.4" height={stripe * 7} fill="#3C3B6E" />
      </>
    ) : (
      <>
        <rect width="8" height="16" fill="#006847" />
        <rect x="8" width="8" height="16" fill="#fff" />
        <rect x="16" width="8" height="16" fill="#CE1126" />
        <circle cx="12" cy="8" r="2.1" fill="#8C6A3C" />
      </>
    )
  }
</svg>

<style>
  .flag {
    flex: none;
    border-radius: 2px;
    box-shadow: 0 0 0 var(--border-hairline) var(--color-border-strong);
  }
</style>

---
// Theme state icons: sun (light), moon (dark), split circle (system). CSS shows
// the one matching [data-theme-choice] on the parent. Decorative.
---

<svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
  <circle cx="12" cy="12" r="4"></circle>
  <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
</svg>
<svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
  <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
</svg>
<svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
  <circle cx="12" cy="12" r="8"></circle>
  <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path>
</svg>

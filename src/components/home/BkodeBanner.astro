---
// BKODE interlude: an editorial break between Samuel's engineering portfolio
// and the separate studio that handles client work. A `surface` band framed
// by strong hairlines, on the page's 11rem axis: the BKODE mark and "client
// work" in the label column; a statement, one explanatory line and a single
// destination in the content column. Only the link is interactive; hovering
// or focusing it strengthens the band's top rule and nudges the ↗.
import ExternalLink from "@/components/system/ExternalLink.astro";
import { links, t, type Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<aside class="bkode" aria-labelledby="bkode-title">
  <div class="page axis bkode-row">
    <p class="bkode-mark">
      <span class="bkode-name">BKODE</span>
      <span class="meta bkode-kind">/ {t(locale, "bkode.label")}</span>
    </p>
    <div class="bkode-body">
      <h2 id="bkode-title" class="bkode-title">{t(locale, "bkode.title")}</h2>
      <p class="bkode-text">{t(locale, "bkode.body")}</p>
      <p class="bkode-action">
        <ExternalLink class="link bkode-link" href={links.bkode} locale={locale} arrow>{t(locale, "bkode.cta")}</ExternalLink>
        <span class="meta bkode-host">bkode.lat</span>
      </p>
    </div>
  </div>
</aside>

<style>
  .bkode {
    position: relative;
    margin-top: var(--spacing-section);
    border-block: var(--border-hairline) solid var(--color-border-strong);
    background-color: var(--color-surface);
  }

  /* The top rule strengthens while the destination is hovered or focused. */
  .bkode::before {
    content: "";
    position: absolute;
    inset: -1px 0 auto;
    border-top: 2px solid var(--color-text);
    opacity: 0;
    transition: opacity var(--motion-section) var(--ease-standard);
  }

  .bkode:has(.bkode-link:hover, .bkode-link:focus-visible)::before {
    opacity: 1;
  }

  .bkode-row {
    padding-block: calc(var(--spacing) * 16);
  }

  @media (max-width: 47.99rem) {
    .bkode-row {
      gap: calc(var(--spacing) * 4);
      padding-block: calc(var(--spacing) * 10);
    }
  }

  .bkode-mark {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 calc(var(--spacing) * 2);
  }

  @media (min-width: 48rem) {
    .bkode-mark {
      flex-direction: column;
      gap: calc(var(--spacing) * 1);
      padding-top: 0.35rem;
    }
  }

  .bkode-name {
    font-size: var(--text-lead);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .bkode-kind {
    color: var(--color-text-muted);
  }

  .bkode-body {
    max-width: 44rem;
  }

  .bkode-title {
    font-size: var(--text-h2);
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .bkode-text {
    max-width: 40rem;
    margin-top: calc(var(--spacing) * 4);
    color: var(--color-text-muted);
  }

  .bkode-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 calc(var(--spacing) * 4);
    margin-top: calc(var(--spacing) * 6);
  }

  .bkode-link {
    min-height: var(--target-min);
    font-weight: 600;
  }

  .bkode-host {
    color: var(--color-text-muted);
  }
</style>

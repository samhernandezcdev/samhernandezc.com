---
// Evidence row for a published work entry. Only status/source, title, problem,
// role, a verified outcome and a short stack; decisions live in the case study.
import type { CollectionEntry } from "astro:content";

import { t, type Locale, type UIKey } from "@/i18n/ui";
import { verifiedOnly } from "@/lib/work";

interface Props {
  entry: CollectionEntry<"work">;
  locale: Locale;
  /** Set once /work/[slug] exists (Phase 4). */
  href?: string;
}

const { entry, locale, href } = Astro.props;
const { data } = entry;
const title = (locale === "es" && data.es?.title) || data.title;
const problem = data.problem ?? ((locale === "es" && data.es?.summary) || data.summary);
const outcome =
  verifiedOnly(data.productionOutcomes)[0] ?? verifiedOnly(data.technicalMeasurements)[0];
const Tag = href ? "a" : "div";
---

<Tag class:list={["work-row", href && "row-link"]} href={href}>
  <div class="work-row-meta">
    <span class="status" data-status={data.status}>{t(locale, `status.${data.status}` as UIKey)}</span>
    <span class="source">{t(locale, `source.${data.source}` as UIKey)}</span>
  </div>
  <h3 class="row-title work-row-title">{title}</h3>
  <p class="work-row-problem">{problem}</p>
  {data.role && <p class="label">{t(locale, "work.role")}: {data.role}</p>}
  {outcome && <p class="work-row-outcome">{outcome.label}: <span class="meta">{outcome.value}{"unit" in outcome && outcome.unit ? ` ${outcome.unit}` : ""}</span></p>}
  {data.stack.length > 0 && <p class="meta">{data.stack.slice(0, 5).join(", ").toLowerCase()}</p>}
</Tag>

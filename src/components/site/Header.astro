---
// Static header, no client JS. The nav lists only routes that exist: Notes
// appears once a note is published, About once /about is built (Phase 6), so
// the links fit on one row at 390px and no menu disclosure is needed yet.
import GitHub from "@/components/icons/GitHub.astro";
import { homePaths, htmlLang, links, t, workPaths, type Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
  /** Path of this page in the other language, when it exists. */
  alternatePath?: string;
  showNotes?: boolean;
  /** Route section the current page belongs to (sets aria-current). */
  current?: "work" | "notes";
}

const { locale, alternatePath, showNotes = false, current } = Astro.props;
const other: Locale = locale === "en" ? "es" : "en";
const home = homePaths[locale];

// Notes are English-only: on Spanish pages the link is marked EN.
const nav = [
  { id: "work", href: workPaths[locale], label: t(locale, "nav.work"), englishOnly: false },
  ...(showNotes
    ? [{ id: "notes", href: "/notes", label: t(locale, "nav.notes"), englishOnly: locale !== "en" }]
    : []),
];
---

<header class="site-header">
  <div class="page site-header-row">
    <a class="wordmark" href={home} aria-label={t(locale, "nav.home")}>Samuel Hernández</a>

    <nav class="site-nav" aria-label={t(locale, "nav.label")}>
      <ul>
        {
          nav.map(({ id, href, label, englishOnly }) => (
            <li>
              <a
                class="link-quiet nav-link"
                href={href}
                hreflang={englishOnly ? "en" : undefined}
                aria-current={current === id ? "page" : undefined}
              >
                {label}
                {englishOnly && (
                  <span class="meta nav-lang">
                    EN<span class="visually-hidden">, {t(locale, "lang.englishOnly")}</span>
                  </span>
                )}
              </a>
            </li>
          ))
        }
        <li>
          <a class="icon-button" href={links.github} rel="me noopener" aria-label="GitHub">
            <GitHub />
          </a>
        </li>
        {
          alternatePath && (
            <li>
              <a
                class="link-quiet nav-link lang-link"
                href={alternatePath}
                hreflang={htmlLang[other]}
                lang={htmlLang[other]}
                aria-label={t(locale, "lang.switchLabel")}
              >
                {t(locale, "lang.switch")}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-hairline) solid var(--color-border);
  }

  .site-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--spacing-component);
    min-height: 4rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    color: var(--color-text);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--spacing-inline);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--spacing-inline);
    font-size: var(--text-small);
  }

  .nav-lang {
    margin-left: 0.35em;
  }

  /* Narrow phones: tighter link padding so the row fits (it wraps below ~340px). */
  @media (max-width: 26rem) {
    .site-nav ul {
      gap: 0;
    }

    .nav-link {
      padding-inline: calc(var(--spacing) * 1.5);
    }
  }

  .lang-link {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
  }
</style>

---
import { links, t, type Locale } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page site-footer-row">
    <p class="meta">© {year} {t(locale, "footer.rights")}</p>
    <ul class="site-footer-links">
      <li><a class="link-quiet" href={links.github} rel="me noopener">GitHub</a></li>
      <li><a class="link-quiet" href={links.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a class="link-quiet" href={links.cv[locale]}>{t(locale, "nav.resume")}</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--spacing-section);
    border-top: var(--border-hairline) solid var(--color-border);
  }

  .site-footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-component);
    padding-block: var(--spacing-component-lg);
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-inline) var(--spacing-component-lg);
    font-size: var(--text-small);
  }

  .site-footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
</style>

---
// Command palette: a compact index of pages, published content and contact
// actions in a native <dialog>. Opens with Cmd/Ctrl+K or the header trigger.
// Every entry is a normal link or button; with JS off the trigger stays hidden
// and the same destinations are reachable through the header, pages and footer.
// Client JS justification: opening a modal on a shortcut, filtering and theme
// switching need a handler; ~1.3 KB gz, inline module; no-JS fallback: regular
// navigation (nothing essential depends on it).
import { aboutPaths, homePaths, htmlLang, links, t, workPaths, type Locale } from "@/i18n/ui";
import { caseStudyPath, getFeaturedWork, getPublishedNotes } from "@/lib/content";

interface Props {
  locale: Locale;
  /** This page in the other language, when it exists. */
  alternatePath?: string;
}

const { locale, alternatePath } = Astro.props;
const other: Locale = locale === "en" ? "es" : "en";
const notes = await getPublishedNotes();
const caseStudies = (await getFeaturedWork()).filter((entry) => caseStudyPath(entry));
const englishOnly = locale !== "en";

type Item = { label: string; href: string; keywords?: string; lang?: string; external?: boolean };

const pages: Item[] = [
  { label: t(locale, "palette.home"), href: homePaths[locale], keywords: "home inicio" },
  { label: t(locale, "nav.work"), href: workPaths[locale], keywords: "work projects proyectos" },
  ...(notes.length > 0
    ? [{ label: t(locale, "nav.notes"), href: "/notes", keywords: "notes notas writing", lang: englishOnly ? "en" : undefined }]
    : []),
  { label: t(locale, "nav.about"), href: aboutPaths[locale], keywords: "about sobre experience experiencia" },
];

const content: Item[] = [
  ...caseStudies.map((entry) => ({
    label: entry.data.title,
    href: caseStudyPath(entry)!,
    keywords: "case study caso de estudio work",
    lang: englishOnly ? "en" : undefined,
  })),
  ...notes.slice(0, 5).map((note) => ({
    label: note.data.title,
    href: `/notes/${note.id}`,
    keywords: `note nota ${note.data.tags.join(" ")}`,
    lang: englishOnly ? "en" : undefined,
  })),
];

const actions: Item[] = [
  { label: `${t(locale, "palette.email")}: ${links.email}`, href: `mailto:${links.email}`, keywords: "email correo contact contacto" },
  { label: "GitHub", href: links.github, keywords: "github code código", external: true },
  { label: "LinkedIn", href: links.linkedin, keywords: "linkedin", external: true },
  { label: t(locale, "palette.cv"), href: links.cv[locale], keywords: "cv resume currículum" },
  ...(alternatePath
    ? [{ label: t(locale, "lang.switchLabel"), href: alternatePath, keywords: "language idioma english español", lang: htmlLang[other] }]
    : []),
];

const themes = [
  { value: "light", label: t(locale, "palette.themeLight") },
  { value: "dark", label: t(locale, "palette.themeDark") },
  { value: "system", label: t(locale, "palette.themeSystem") },
];

const groups = [
  { id: "palette-pages", title: t(locale, "palette.navigation"), items: pages },
  { id: "palette-content", title: t(locale, "palette.content"), items: content },
  { id: "palette-actions", title: t(locale, "palette.actions"), items: actions },
].filter((group) => group.items.length > 0);
---

<button
  type="button"
  class="icon-button palette-trigger"
  aria-label={t(locale, "palette.open")}
  aria-haspopup="dialog"
  aria-keyshortcuts="Control+K Meta+K"
  data-palette-open
  hidden
>
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
    <circle cx="11" cy="11" r="6.5"></circle>
    <path d="m20 20-4.2-4.2"></path>
  </svg>
  <kbd class="palette-kbd" data-palette-kbd>{t(locale, "palette.hint")}</kbd>
</button>

<dialog class="palette" aria-label={t(locale, "palette.title")} data-palette>
  <div class="palette-panel">
    <label class="label palette-field">
      <span class="visually-hidden">{t(locale, "palette.filter")}</span>
      <input
        class="palette-filter"
        type="search"
        placeholder={`${t(locale, "palette.title")}…`}
        autocomplete="off"
        spellcheck="false"
        aria-describedby="palette-status"
        data-palette-filter
      />
    </label>

    <div class="palette-groups">
      {
        groups.map((group) => (
          <div class="palette-group" role="group" aria-labelledby={group.id} data-palette-group>
            <p id={group.id} class="label palette-group-title">{group.title}</p>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a
                    class="palette-item"
                    href={item.href}
                    hreflang={item.lang}
                    rel={item.external ? "me noopener" : undefined}
                    data-palette-item
                    data-keywords={item.keywords}
                  >
                    <span lang={item.lang}>{item.label}</span>
                    {item.lang === "en" && englishOnly && <span class="meta palette-lang">EN</span>}
                  </a>
                </li>
              ))}
              {group.id === "palette-actions" && (
                <li class="palette-themes" data-palette-item data-keywords="theme tema light dark system claro oscuro sistema">
                  <span class="palette-themes-label">{t(locale, "palette.theme")}</span>
                  <span class="palette-themes-options">
                    {themes.map((theme) => (
                      <button type="button" class="palette-theme" data-theme-value={theme.value} aria-pressed="false">
                        {theme.label}
                      </button>
                    ))}
                  </span>
                </li>
              )}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="label palette-empty" data-palette-empty hidden>{t(locale, "palette.empty")}</p>
    <p id="palette-status" class="visually-hidden" aria-live="polite" data-palette-status data-results-label={t(locale, "palette.results")}></p>
  </div>
</dialog>

<script>
  type ThemeChoice = "light" | "dark" | "system";

  const dialog = document.querySelector<HTMLDialogElement>("[data-palette]");
  const trigger = document.querySelector<HTMLButtonElement>("[data-palette-open]");

  if (dialog && trigger && typeof dialog.showModal === "function") {
    const filter = dialog.querySelector<HTMLInputElement>("[data-palette-filter]")!;
    const status = dialog.querySelector<HTMLElement>("[data-palette-status]")!;
    const empty = dialog.querySelector<HTMLElement>("[data-palette-empty]")!;
    const entries = [...dialog.querySelectorAll<HTMLElement>("[data-palette-item]")];
    const groups = [...dialog.querySelectorAll<HTMLElement>("[data-palette-group]")];
    const themeButtons = [...dialog.querySelectorAll<HTMLButtonElement>("[data-theme-value]")];
    const kbd = trigger.querySelector("[data-palette-kbd]");
    if (kbd && /Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = "⌘K";

    const focusables = () =>
      entries
        .filter((entry) => !entry.closest("li")?.hidden)
        .flatMap((entry) => (entry.matches("a") ? [entry] : [...entry.querySelectorAll<HTMLElement>("button")]));

    const applyFilter = () => {
      const query = filter.value.trim().toLowerCase();
      let shown = 0;
      for (const entry of entries) {
        const text = `${entry.textContent} ${entry.dataset.keywords ?? ""}`.toLowerCase();
        const match = !query || text.includes(query);
        entry.closest("li")!.hidden = !match;
        if (match) shown++;
      }
      for (const group of groups) group.hidden = !group.querySelector("li:not([hidden])");
      empty.hidden = shown > 0;
      status.textContent = query ? `${shown} ${status.dataset.resultsLabel}` : "";
    };

    const currentTheme = (): ThemeChoice => {
      try {
        const stored = localStorage.getItem("theme");
        return stored === "light" || stored === "dark" ? stored : "system";
      } catch {
        return "system";
      }
    };

    const syncTheme = () => {
      const choice = currentTheme();
      for (const button of themeButtons) button.setAttribute("aria-pressed", String(button.dataset.themeValue === choice));
    };

    const setTheme = (choice: ThemeChoice) => {
      const apply = () => {
        const root = document.documentElement;
        if (choice === "system") delete root.dataset.theme;
        else root.dataset.theme = choice;
        try {
          if (choice === "system") localStorage.removeItem("theme");
          else localStorage.setItem("theme", choice);
        } catch {
          // Storage unavailable: the choice lasts for this page view.
        }
        syncTheme();
      };
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce && "startViewTransition" in document) document.startViewTransition(apply);
      else apply();
    };

    const open = () => {
      if (dialog.open) return;
      filter.value = "";
      applyFilter();
      syncTheme();
      dialog.showModal();
      filter.focus();
    };

    trigger.hidden = false;
    trigger.addEventListener("click", open);

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });

    // A click on the backdrop lands on the <dialog> itself, outside the panel.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    filter.addEventListener("input", applyFilter);

    dialog.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
      const items = focusables();
      if (items.length === 0) return;
      const index = items.indexOf(document.activeElement as HTMLElement);
      let next = 0;
      if (event.key === "ArrowDown") next = index < 0 ? 0 : Math.min(index + 1, items.length - 1);
      if (event.key === "ArrowUp") next = index <= 0 ? -1 : index - 1;
      if (event.key === "End") next = items.length - 1;
      if (event.key === "Home" && document.activeElement === filter) return;
      event.preventDefault();
      if (next < 0) filter.focus();
      else items[next].focus();
    });

    for (const button of themeButtons) {
      button.addEventListener("click", () => setTheme(button.dataset.themeValue as ThemeChoice));
    }
  }
</script>

<style>
  .palette-trigger {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
    width: auto;
    min-width: var(--target-min);
    padding-inline: calc(var(--spacing) * 2);
  }

  .palette-trigger[hidden] {
    display: none;
  }

  .palette-kbd {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-text-muted);
  }

  /* The shortcut hint only helps with a keyboard and a fine pointer. */
  @media (pointer: fine) {
    .palette-kbd {
      display: inline;
    }
  }

  .palette {
    width: min(34rem, calc(100vw - 2 * var(--spacing-gutter)));
    max-height: min(36rem, calc(100dvh - 2 * var(--spacing-gutter)));
    margin: calc(var(--spacing) * 16) auto auto;
    padding: 0;
    border: var(--border-hairline) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-surface-raised);
    color: var(--color-text);
  }

  .palette::backdrop {
    background-color: color-mix(in oklab, var(--color-bg) 70%, transparent);
  }

  @media (max-width: 30rem) {
    .palette {
      margin-top: var(--spacing-gutter);
    }
  }

  .palette-panel {
    display: grid;
    gap: var(--spacing-component);
    padding: var(--spacing-component);
  }

  .palette-filter {
    width: 100%;
    min-height: var(--target-min);
    padding-inline: calc(var(--spacing) * 3);
    border: var(--border-hairline) solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-size: max(16px, var(--text-small));
  }

  .palette-filter:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  .palette-groups {
    display: grid;
    gap: var(--spacing-component);
  }

  .palette-group[hidden] {
    display: none;
  }

  .palette-group-title {
    margin-bottom: calc(var(--spacing) * 1);
  }

  .palette-group li[hidden] {
    display: none;
  }

  .palette-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-inline);
    min-height: var(--target-min);
    padding-inline: calc(var(--spacing) * 2);
    border-top: var(--border-hairline) solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .palette-item:hover,
  .palette-item:focus-visible {
    background-color: var(--color-surface);
  }

  .palette-item:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -2px;
  }

  .palette-lang {
    flex: none;
  }

  .palette-themes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-inline);
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    border-top: var(--border-hairline) solid var(--color-border);
  }

  .palette-themes-options {
    display: flex;
    gap: calc(var(--spacing) * 1);
  }

  .palette-theme {
    min-height: var(--target-min);
    padding-inline: calc(var(--spacing) * 3);
    border: var(--border-hairline) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .palette-theme[aria-pressed="true"] {
    border-color: var(--color-border-strong);
    border-bottom: 2px solid var(--color-text);
    background-color: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
  }

  .palette-empty[hidden] {
    display: none;
  }
</style>

---
import ThemeScript from "@/components/system/ThemeScript.astro";
import { defaultLocale, htmlLang, ogLocale, t, type Locale } from "@/i18n/ui";
import { getPublishedNotes } from "@/lib/content";
import "@/styles/system.css";
import { siteUrl } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Paths of this page in each language that exists, e.g. { en: "/", es: "/es" }. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  /** "article" for notes; publication dates are emitted only for articles. */
  ogType?: "website" | "article";
  published?: Date;
  modified?: Date;
}

const {
  title,
  description,
  locale = defaultLocale,
  alternates = {},
  noindex = false,
  ogType = "website",
  published,
  modified,
} = Astro.props;

const site = siteUrl(Astro.site);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", site).href;
const alternateLinks = Object.entries(alternates).map(([lang, path]) => ({
  lang: htmlLang[lang as Locale],
  href: new URL(path, site).href,
}));
const xDefault = alternates[defaultLocale];
// One static, site-level share image (public/og-default.png, rendered by scripts/og-image.mjs).
const ogImage = new URL("/og-default.png", site).href;
const ogImageAlt = "Samuel Hernández, Software Engineer: backend systems, data and applied AI.";
// RSS autodiscovery only once the feed has content.
const hasFeed = (await getPublishedNotes()).length > 0;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Samuel Hernández" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site).href} />}

    <meta property="og:type" content={ogType} />
    {ogType === "article" && published && <meta property="article:published_time" content={published.toISOString()} />}
    {ogType === "article" && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {ogType === "article" && <meta property="article:author" content="Samuel Hernández" />}
    <meta property="og:site_name" content="Samuel Hernández" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {hasFeed && <link rel="alternate" type="application/rss+xml" title="Engineering notes · Samuel Hernández" href={new URL("/rss.xml", site).href} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, "nav.skipToContent")}</a>
    <slot />
  </body>
</html>

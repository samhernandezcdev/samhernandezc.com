---
import ThemeScript from "@/components/system/ThemeScript.astro";
import { defaultLocale, htmlLang, ogLocale, t, type Locale } from "@/i18n/ui";
import "@/styles/system.css";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Paths of this page in each language that exists, e.g. { en: "/", es: "/es" }. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
}

const { title, description, locale = defaultLocale, alternates = {}, noindex = false } = Astro.props;

const site = Astro.site ?? new URL("https://samhernandezc.com");
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", site).href;
const alternateLinks = Object.entries(alternates).map(([lang, path]) => ({
  lang: htmlLang[lang as Locale],
  href: new URL(path, site).href,
}));
const xDefault = alternates[defaultLocale];
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Samuel Hernández" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, site).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Samuel Hernández" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, "nav.skipToContent")}</a>
    <slot />
  </body>
</html>
